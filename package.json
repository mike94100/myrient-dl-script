{
  "name": "roms-as-code",
  "version": "1.0.0",
  "description": "ROM Collection Browser - A modern web application for browsing and downloading ROM collections",
  "main": "src/app.js",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "preview": "vite preview",
    "watch": "vite build --watch",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "format": "prettier --write src/**/*.js",
    "test": "jest",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "roms",
    "emulation",
    "web-app",
    "javascript"
  ],
  "author": "mike94100",
  "license": "GPL 3.0",
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.22.0",
    "babel-loader": "^9.1.0",
    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^7.0.4",
    "eslint": "^8.50.0",
    "html-webpack-plugin": "^5.6.6",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "mini-css-extract-plugin": "^2.10.0",
    "prettier": "^3.0.0",
    "style-loader": "^4.0.0",
    "vite": "^7.3.1",
    "webpack": "^5.104.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.3"
  },
  "babel": {
    "presets": [
      [
        "@babel/preset-env",
        {
          "targets": "> 1%, not dead",
          "modules": false
        }
      ]
    ]
  },
  "eslintConfig": {
    "env": {
      "browser": true,
      "es2021": true
    },
    "extends": [
      "eslint:recommended"
    ],
    "overrides": [
      {
        "files": [
          "*.test.js",
          "**/setupTests.js"
        ],
        "env": {
          "jest": true
        }
      }
    ],
    "parserOptions": {
      "ecmaVersion": "latest",
      "sourceType": "module"
    },
    "rules": {
      "no-unused-vars": "warn",
      "no-console": "off"
    }
  },
  "prettier": {
    "semi": true,
    "trailingComma": "es5",
    "singleQuote": true,
    "printWidth": 100,
    "tabWidth": 2
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/src/setupTests.js"
    ]
  }
}
